# Local environment template for ma-creations-api
# Copy values into your shell / IDE env (Spring does not auto-load .env). Do not commit real secrets.
#
# For Railway UAT variable names and values, see docs/UAT_RAILWAY_DEPLOYMENT.md
# Railway must use SPRING_PROFILES_ACTIVE=uat (never "local").

SPRING_PROFILES_ACTIVE=local
# Railway injects PORT automatically; local can use SERVER_PORT.
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/ma_creations?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

CORS_ALLOWED_ORIGINS=http://localhost:5173

UPLOAD_DIR=uploads/products
UPLOAD_PUBLIC_BASE_PATH=/api/media

# Admin JWT — must be at least 32 characters. Override in every real environment.
JWT_SECRET=dev-only-change-me-ma-creations-jwt-secret-key
JWT_EXPIRATION_MS=86400000

# Customer JWT — separate from admin. Must be at least 32 characters; use a different secret.
CUSTOMER_JWT_SECRET=dev-only-change-me-ma-creations-customer-jwt-key
CUSTOMER_JWT_EXPIRATION_MS=86400000

# Customer OTP (DevOtpService — no real SMS provider yet)
CUSTOMER_OTP_EXPIRY_MINUTES=5
CUSTOMER_OTP_MAX_ATTEMPTS=5
# Local profile sets fixed OTP 123456; leave empty / unset on UAT/Railway
CUSTOMER_OTP_DEV_FIXED=
CUSTOMER_OTP_DEV_LOG=false

# Optional: create first admin when admin_user table is empty (password is BCrypt-hashed on save)
ADMIN_BOOTSTRAP_EMAIL=admin@macreations.test
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# Checkout preview — V1 charge modes live in application.yml (shipping/COD FIXED ₹20, tax ZERO).
CHECKOUT_PRICING_VERSION=v1
CHECKOUT_PREVIEW_SECRET=dev-only-checkout-preview-secret-key

# Razorpay — use TEST/sandbox keys only in local/UAT. Never commit real secrets.
# KEY_SECRET and WEBHOOK_SECRET must stay server-side (never in frontend).
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAY_LATER_ENABLED=false

# If port 8080 is already in use on Windows, set SERVER_PORT=8081 and match VITE_API_BASE_URL.
