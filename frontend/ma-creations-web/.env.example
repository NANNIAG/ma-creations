# Frontend environment template
# Copy to .env.local for local overrides. Do not commit secrets.
#
# All VITE_* values are PUBLIC (bundled into the browser).
# Never put JWT secrets, DB passwords, or admin credentials here.

# Required for API calls (use the port your Spring Boot app actually listens on)
# Local note: if port 8080 is busy, backend may use 8081 — match it here.
VITE_API_BASE_URL=http://localhost:8080

# Customer auth uses mobile OTP via the API — no frontend OTP secrets.
# Local backend (profile=local) uses fixed OTP 123456 via DevOtpService (not for production).

# --- Optional brand / social (public config) ---

# Temporary font override until Inter vs Montserrat is confirmed (CLIENT CONFIRMATION REQUIRED).
# Example: "Montserrat", system-ui, sans-serif
# VITE_BRAND_FONT_FAMILY="Inter", "Montserrat", system-ui, sans-serif

# Optional logo (place file under public/branding/). Leave unset for text wordmark.
# VITE_BRAND_LOGO_URL=/branding/logo.png

# WhatsApp Business number — digits with country code, no + or spaces.
# Leave unset to show a safe “not configured” UI (do not invent a production number).
# VITE_WHATSAPP_NUMBER=9198XXXXXXXX

# Instagram follow CTA (live grid still TBD — CLIENT CONFIRMATION REQUIRED)
# VITE_INSTAGRAM_HANDLE=your_handle_here
# VITE_INSTAGRAM_FOLLOW_URL=https://instagram.com/your_handle_here

# --- Optional hero assets ---
# Place image files under public/heroes/ then reference them here.
# Default Shop Now scrolls to #categories until destination is confirmed.
# VITE_HERO_SHOP_NOW_TARGET=#categories
# VITE_HERO_SLIDES_JSON=[{"id":"1","title":"","subtitle":"","image":"/heroes/banner-1.jpg","fullBleed":true}]

# --- Optional category tile images ---
# See public/categories/README.md
# VITE_CATEGORY_IMAGE_MAP_JSON={"hydration-drinkware":"/categories/hydration-drinkware.jpg"}
# VITE_CATEGORY_IMAGES_AUTO=true
# Optional full category PLP banners (designed creatives under public/heroes/)
# VITE_CATEGORY_BANNER_MAP_JSON={"hydration-drinkware":"/heroes/hydration-drinkware.jpg","lunch-meal-prep":"/heroes/lunch-meal-prep.jpg"}
